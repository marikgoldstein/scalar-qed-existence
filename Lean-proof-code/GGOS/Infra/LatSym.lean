module

public import Mathlib

/-!
# `GGOS.LatSym`

Infrastructure of the [GG-OS] definitions (structures, abbreviations and their lemmas).
-/

@[expose] public section

noncomputable section

open MeasureTheory Filter Topology

namespace GGOS

/-- A lattice symmetry `x ↦ A x + shift`, `A e_μ = sgn μ • e_{perm μ}`: the group generated by
the translations, the reflections in the site planes and the cubic group about the sites. -/
structure LatSym (R : Type*) [CommRing R] where
  /-- the permutation of the directions -/
  perm : Equiv.Perm (Fin 3)
  /-- the signs -/
  sgn : Fin 3 → ℤˣ
  /-- the translation part -/
  shift : Fin 3 → R

end GGOS

end

end
